APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
HASH_VERIFY=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ua-fms-local
REVERB_APP_KEY=ua-fms-local-key
REVERB_APP_SECRET=replace-with-a-random-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
# Optional internal endpoint for Laravel's event publisher when a proxy fronts Reverb.
# Browser clients continue to use REVERB_HOST / REVERB_PORT / REVERB_SCHEME.
# REVERB_BROADCAST_HOST=127.0.0.1
# REVERB_BROADCAST_PORT=8080
# REVERB_BROADCAST_SCHEME=http
FILESYSTEM_DISK=local
# Optional persistent local path for private payment receipt uploads.
# PAYMENT_RECEIPTS_PATH=/var/lib/ua-fms/payment-receipts
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=uagsuorg@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="uagsuorg@gmail.com"
MAIL_FROM_NAME="University of Antique GSU"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ============================================
# FMS Portal Access Configuration
# ============================================
# These settings control access to the hidden portal entry.
# If you are using the current web-only workflow, only
# FMS_LOGIN_URL and FMS_ACCESS_TOKEN are needed.
#
# The role-specific launcher secrets below are retained only for
# the legacy desktop launcher flow and are not required for normal
# Laravel web deployment.

# Login entry URL used by current portal entry
# Development: http://127.0.0.1:8000/fms-portal-entry
# LAN Testing: http://192.168.x.x:8000/fms-portal-entry
# Production:  https://your-domain.com/fms-portal-entry
FMS_LOGIN_URL=http://127.0.0.1:8000/fms-portal-entry

# Shared access token required by the portal entry URL
# Change to a strong random string for production
FMS_ACCESS_TOKEN=UA-FMS-ACCESS-2025

# Legacy desktop launcher-only values (optional)
# FMS_ADMIN_SECRET=UA-ADMIN-2025
# FMS_COLLEGE_SECRET=UA-COLLEGE-2025
# FMS_ORG_SECRET=UA-ORG-2025
# FMS_LAUNCHER_SECRET=UA-FMS-2025
